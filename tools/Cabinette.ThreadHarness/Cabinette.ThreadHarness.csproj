<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dev harness for the thread view: hosts ThreadView with an in-memory library and fake services.
    Not shipped. See Program.cs for the command-line flags (screenshots for visual checks).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <RootNamespace>Cabinette.ThreadHarness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cabinette.App\Cabinette.App.csproj" />
    <ProjectReference Include="..\..\src\Cabinette.Core\Cabinette.Core.csproj" />
    <ProjectReference Include="..\..\src\Cabinette.Windows\Cabinette.Windows.csproj" />
  </ItemGroup>

</Project>
