<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dev tool: renders the app icon, the tray icon variants, PNG previews and the vector logo resource
    from the SVGs in assets/logo. Not shipped. Run this project after changing a logo SVG and commit the results
    (see Program.cs for the outputs).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <RootNamespace>Cabinette.IconGen</RootNamespace>
  </PropertyGroup>

</Project>
