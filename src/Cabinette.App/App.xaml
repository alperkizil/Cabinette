<Application x:Class="Cabinette.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <!-- Cabinette color tokens. Index 2 is swapped at runtime between Light.xaml and Dark.xaml by the theme service. -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <!-- Shared control styles (scroll bars, menus, tooltips, buttons, text boxes, rows). -->
                <ResourceDictionary Source="Styles/Controls.xaml" />
                <!-- Dialog view templates (view model type → view). -->
                <ResourceDictionary Source="Views/Dialogs/DialogTemplates.xaml" />
                <!-- The app logo as vector images (Cab.Logo, Cab.LogoSmall), generated by tools/Cabinette.IconGen. -->
                <ResourceDictionary Source="Assets/CabinetteLogo.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Text-size zoom (Settings › Appearance). Replaced at runtime by Services/UiScale. -->
            <ScaleTransform x:Key="Cab.UiScaleTransform" ScaleX="1" ScaleY="1" />

            <!-- Font families (Settings › Appearance › Font), here the default. Replaced at runtime by Services/UiFont. -->
            <FontFamily x:Key="Shell.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="Shell.FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>

            <!-- Text weights (Settings › Appearance › Bold text), here as designed. Replaced at runtime by Services/UiWeight. -->
            <FontWeight x:Key="Cab.FontWeight.Light">Light</FontWeight>
            <FontWeight x:Key="Cab.FontWeight.Body">Normal</FontWeight>
            <FontWeight x:Key="Cab.FontWeight.Medium">Medium</FontWeight>
            <FontWeight x:Key="Cab.FontWeight.Strong">SemiBold</FontWeight>
            <FontWeight x:Key="Cab.FontWeight.Bold">Bold</FontWeight>
        </ResourceDictionary>
    </Application.Resources>
</Application>
