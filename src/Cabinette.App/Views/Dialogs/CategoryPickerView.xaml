<UserControl x:Class="Cabinette.App.Views.Dialogs.CategoryPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Cabinette.App.Localization"
             xmlns:shell="clr-namespace:Cabinette.App.Views.Shell"
             x:Name="Root">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Margin="24,22,24,0" Style="{StaticResource Shell.Text.DialogTitle}" Text="{Binding Title}" />

        <!-- Search -->
        <Grid Grid.Row="1" Height="38" Margin="20,16,20,8">
            <Border Background="{DynamicResource Cab.SearchBoxBackground}" CornerRadius="19" />
            <ui:SymbolIcon Margin="14,0,0,0"
                           HorizontalAlignment="Left"
                           FontSize="16"
                           Foreground="{DynamicResource Cab.TextSecondary}"
                           Symbol="Search16" />
            <TextBox x:Name="SearchBox"
                     Margin="42,0,14,0"
                     PreviewKeyDown="OnSearchPreviewKeyDown"
                     Style="{StaticResource Shell.BareTextBox}"
                     Tag="{loc:Loc Picker_SearchPlaceholder}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Tree (flattened, indented) -->
        <ListBox x:Name="List"
                 Grid.Row="2"
                 MinHeight="200"
                 ItemsSource="{Binding VisibleNodes}"
                 KeyDown="OnListKeyDown"
                 SelectedItem="{Binding Selected}"
                 Style="{StaticResource Shell.ListBox}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Shell.RowItem}">
                    <Setter Property="Margin" Value="12,1" />
                    <Setter Property="Padding" Value="8,0" />
                    <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="44" Margin="{Binding Indent}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Width="24"
                                Height="24"
                                Command="{Binding DataContext.ToggleCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                Focusable="False"
                                Style="{StaticResource Shell.SmallIconButton}"
                                Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon FontSize="14" RenderTransformOrigin="0.5,0.5" Symbol="ChevronRight16">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Button>
                        <shell:CategoryAvatar Grid.Column="1"
                                              Margin="4,0,12,0"
                                              VerticalAlignment="Center"
                                              IconKey="{Binding IconKey}"
                                              Size="30"
                                              Source="{Binding Icon}" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                            <Setter Property="FontWeight" Value="{DynamicResource Cab.FontWeight.Strong}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2"
                   Margin="24,40"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Style="{StaticResource Shell.Text.Secondary}"
                   Text="{loc:Loc Picker_Empty}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <!-- Footer -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource Cab.Divider}" BorderThickness="0,1,0,0">
            <Grid Margin="20,14,24,18">
                <Button HorizontalAlignment="Left"
                        Command="{Binding NewCategoryCommand}"
                        Style="{StaticResource Shell.TextButton}"
                        Visibility="{Binding AllowCreate, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,6,0" FontSize="16" Symbol="FolderAdd20" />
                        <TextBlock Text="{loc:Loc Picker_NewCategory}" />
                    </StackPanel>
                </Button>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Command="{Binding CancelCommand}"
                            Content="{loc:Loc Common_Cancel}"
                            Style="{StaticResource Shell.SecondaryButton}" />
                    <Button MinWidth="96"
                            Command="{Binding ChooseCommand}"
                            Content="{loc:Loc Picker_Choose}"
                            Style="{StaticResource Shell.AccentButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
