<UserControl x:Class="Cabinette.App.Views.Dialogs.NewCategoryDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Cabinette.App.Localization"
             xmlns:shell="clr-namespace:Cabinette.App.Views.Shell">
    <StackPanel Margin="24,22,24,20">
        <TextBlock Style="{StaticResource Shell.Text.DialogTitle}" Text="{Binding Title}" />

        <!-- Icon -->
        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <shell:CategoryAvatar IconKey="folder" Size="72" Source="{Binding IconPreview}" />
            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ChooseIconCommand}" Style="{StaticResource Shell.SecondaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Symbol="ImageEdit20" />
                            <TextBlock Text="{loc:Loc NewCategory_ChooseIcon}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="6,0,0,0"
                            Command="{Binding ClearIconCommand}"
                            Content="{loc:Loc NewCategory_RemoveIcon}"
                            Style="{StaticResource Shell.TextButton}"
                            Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Margin="2,8,0,0" Style="{StaticResource Shell.Text.Secondary}" Text="{loc:Loc NewCategory_IconHint}" />
            </StackPanel>
        </Grid>

        <!-- Name -->
        <TextBlock Margin="0,22,0,6" Style="{StaticResource Shell.Text.Secondary}" Text="{loc:Loc NewCategory_Name}" />
        <TextBox x:Name="NameBox"
                 Style="{StaticResource Shell.TextBox}"
                 Tag="{loc:Loc NewCategory_NamePlaceholder}"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Parent -->
        <TextBlock Margin="0,16,0,6" Style="{StaticResource Shell.Text.Secondary}" Text="{loc:Loc NewCategory_Parent}" />
        <Button HorizontalContentAlignment="Stretch" Command="{Binding ChooseParentCommand}" Style="{StaticResource Shell.SecondaryButton}" Padding="12,0" MinHeight="40">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Margin="0,0,10,0" FontSize="18" Foreground="{DynamicResource Cab.TextSecondary}" Symbol="FolderOpen20" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding ParentPath}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="{DynamicResource Cab.FontWeight.Strong}"
                           Foreground="{DynamicResource Cab.Accent}"
                           Text="{loc:Loc NewCategory_ChooseParent}" />
            </Grid>
        </Button>

        <TextBlock MinHeight="18" Margin="2,10,0,0" Style="{StaticResource Shell.Text.Error}" Text="{Binding Error}" />

        <StackPanel Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Content="{loc:Loc Common_Cancel}"
                    Style="{StaticResource Shell.SecondaryButton}" />
            <Button MinWidth="96"
                    Command="{Binding CreateCommand}"
                    Content="{loc:Loc Common_Create}"
                    Style="{StaticResource Shell.AccentButton}" />
        </StackPanel>
    </StackPanel>
</UserControl>
