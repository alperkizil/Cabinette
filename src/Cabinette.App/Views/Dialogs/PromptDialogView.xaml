<UserControl x:Class="Cabinette.App.Views.Dialogs.PromptDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Cabinette.App.Localization">
    <StackPanel Margin="24,22,24,20">
        <TextBlock Style="{StaticResource Shell.Text.DialogTitle}" Text="{Binding Title}" />
        <TextBlock Margin="0,18,0,6" Style="{StaticResource Shell.Text.Secondary}" Text="{Binding Label}" />
        <TextBox x:Name="Input" Style="{StaticResource Shell.TextBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock MinHeight="18"
                   Margin="2,6,0,0"
                   Style="{StaticResource Shell.Text.Error}"
                   Text="{Binding Error}" />
        <StackPanel Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"
                    Content="{loc:Loc Common_Cancel}"
                    Style="{StaticResource Shell.SecondaryButton}" />
            <Button MinWidth="96"
                    Command="{Binding OkCommand}"
                    Content="{loc:Loc Common_Ok}"
                    Style="{StaticResource Shell.AccentButton}" />
        </StackPanel>
    </StackPanel>
</UserControl>
