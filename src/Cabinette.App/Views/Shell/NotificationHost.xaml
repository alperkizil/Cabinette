<UserControl x:Class="Cabinette.App.Views.Shell.NotificationHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Cabinette.App.Localization">
    <!-- DataContext: NotificationService. Progress cards stacked above the snackbar. -->
    <StackPanel Margin="12,0,12,12">
        <ItemsControl Focusable="False" ItemsSource="{Binding Tasks}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8" Padding="16,12,10,14" Style="{StaticResource Shell.Card}" Background="{DynamicResource Cab.InputBackground}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.RowSpan="2" Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Ellipse Fill="{DynamicResource Cab.TagChipBackground}" />
                                <ui:SymbolIcon FontSize="18" Foreground="{DynamicResource Cab.TagChipText}" Symbol="ArrowUpload20" />
                            </Grid>
                            <TextBlock Grid.Column="1" FontSize="13.5" FontWeight="{DynamicResource Cab.FontWeight.Strong}" Foreground="{DynamicResource Cab.TextPrimary}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="0,2,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource Cab.TextSecondary}"
                                       Text="{Binding Detail}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.RowSpan="2"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Command="{Binding CancelCommand}"
                                    Content="{loc:Loc Intake_Cancel}"
                                    IsEnabled="{Binding IsCancelling, Converter={StaticResource InverseBool}}"
                                    Style="{StaticResource Shell.TextButton}" />
                            <ProgressBar Grid.Row="2"
                                         Grid.ColumnSpan="3"
                                         Margin="0,12,6,0"
                                         IsIndeterminate="{Binding IsIndeterminate}"
                                         Style="{StaticResource Shell.ProgressBar}"
                                         Value="{Binding Progress, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Snackbar (inverted colors so it stands out in both themes) -->
        <Border x:Name="Snackbar"
                Padding="14,10,8,10"
                Background="{DynamicResource Cab.TextPrimary}"
                CornerRadius="10"
                DataContext="{Binding Current}"
                MouseEnter="OnSnackbarMouseEnter"
                MouseLeave="OnSnackbarMouseLeave"
                Visibility="{Binding Converter={StaticResource NullToVisibility}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.25" ShadowDepth="4" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="SnackShift" />
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Margin="0,0,10,0" VerticalAlignment="Center" FontSize="18" Symbol="{Binding Kind, Converter={StaticResource NotificationSymbol}}">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Foreground" Value="{DynamicResource Cab.SidebarBackground}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Success">
                                    <Setter Property="Foreground" Value="{DynamicResource Cab.Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                    <Setter Property="Foreground" Value="{DynamicResource Cab.Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Error">
                                    <Setter Property="Foreground" Value="{DynamicResource Cab.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="13.5"
                           Foreground="{DynamicResource Cab.SidebarBackground}"
                           LineHeight="19"
                           Text="{Binding Message}"
                           TextWrapping="Wrap" />
                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        Command="{Binding RunActionCommand}"
                        Content="{Binding ActionText}"
                        Style="{StaticResource Shell.TextButton}"
                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                <Button Grid.Column="3"
                        Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding DismissCommand}"
                        Foreground="{DynamicResource Cab.SidebarBackground}"
                        Style="{StaticResource Shell.SmallIconButton}"
                        AutomationProperties.Name="{loc:Loc Common_Close}" ToolTip="{loc:Loc Common_Close}">
                    <ui:SymbolIcon Foreground="{DynamicResource Cab.SidebarBackground}" Symbol="Dismiss16" />
                </Button>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
