<ui:FluentWindow x:Class="Cabinette.App.Views.Shell.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:Cabinette.App.Localization"
                 xmlns:motion="clr-namespace:Cabinette.App.Views.Motion"
                 xmlns:shell="clr-namespace:Cabinette.App.Views.Shell"
                 xmlns:dialogs="clr-namespace:Cabinette.App.Views.Dialogs"
                 xmlns:threadViews="clr-namespace:Cabinette.App.Views.Thread"
                 Title="{loc:Loc App_Name}"
                 Icon="pack://application:,,,/Assets/Cabinette.ico"
                 Width="1200"
                 Height="760"
                 MinWidth="900"
                 MinHeight="600"
                 Background="{DynamicResource Cab.WindowBackground}"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="{DynamicResource Shell.Font}"
                 FontWeight="{DynamicResource Cab.FontWeight.Body}"
                 Foreground="{DynamicResource Cab.TextPrimary}"
                 TextOptions.TextFormattingMode="Ideal"
                 UseLayoutRounding="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <!-- DataContext: MainViewModel -->
    <Grid x:Name="Root"
          AllowDrop="True"
          Background="{DynamicResource Cab.WindowBackground}"
          DragEnter="OnRootDragOver"
          DragLeave="OnRootDragLeave"
          DragOver="OnRootDragOver"
          Drop="OnRootDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (WPF-UI's style gives it a weight of its own, so the app name gets Bold text from here) -->
        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Height="38"
                     Background="Transparent"
                     ButtonsForeground="{DynamicResource Cab.TextPrimary}"
                     CloseWindowByDoubleClickOnIcon="False"
                     FontWeight="{DynamicResource Cab.FontWeight.Body}">
            <ui:TitleBar.Header>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <!-- App icon (the 16 px design, drawn as vectors so it stays sharp at any display scale) -->
                    <Image Width="16" Height="16" VerticalAlignment="Center" Source="{StaticResource Cab.LogoSmall}" />

                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               Foreground="{DynamicResource Cab.TextPrimary}"
                               Text="{loc:Loc App_Name}" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Panes (scaled by the text-size setting; the title bar stays at its native size) -->
        <Grid Grid.Row="1" LayoutTransform="{DynamicResource Cab.UiScaleTransform}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="380" MinWidth="300" MaxWidth="560" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <shell:ChatListPane x:Name="LeftPane" Grid.Column="0" />
            <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Background="{DynamicResource Cab.Divider}" />
            <GridSplitter Grid.Column="0"
                          Width="6"
                          Margin="0,0,-3,0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Stretch"
                          Panel.ZIndex="1"
                          Background="Transparent"
                          Focusable="False"
                          ResizeBehavior="CurrentAndNext"
                          ResizeDirection="Columns" />

            <Grid x:Name="RightPane" Grid.Column="1" ClipToBounds="True">
                <shell:EmptyStateView Visibility="{Binding HasThread, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                <Grid x:Name="ThreadHost" Visibility="{Binding HasThread, Converter={StaticResource BoolToVisibility}}">
                    <threadViews:ThreadView x:Name="ThreadView" DataContext="{Binding CurrentThread}" />
                </Grid>
            </Grid>
        </Grid>

        <!--
            Drop anywhere the panes don't claim (title bar, chat-list header and search): files are sorted by type.
            The thread, the chat list and the empty state show their own highlights. Animated by DropZone.
        -->
        <Grid x:Name="RootDropOverlay" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Collapsed">
            <Rectangle Fill="{DynamicResource Cab.OverlayBackground}" />
            <Rectangle Margin="12"
                       RadiusX="16"
                       RadiusY="16"
                       Stroke="{DynamicResource Cab.Accent}"
                       StrokeDashArray="5 4"
                       StrokeThickness="2.5"
                       motion:DropZone.Part="Frame" />
            <Border Padding="36,28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    LayoutTransform="{DynamicResource Cab.UiScaleTransform}"
                    Style="{StaticResource Shell.Card}"
                    motion:DropZone.Part="Card">
                <StackPanel>
                    <Grid Width="68" Height="68" HorizontalAlignment="Center">
                        <Ellipse Fill="{DynamicResource Cab.Accent}" Opacity="0.16" />
                        <ui:SymbolIcon FontSize="32" Foreground="{DynamicResource Cab.Accent}" Symbol="ArrowDownload24" motion:DropZone.Part="Icon" />
                        <!-- After a drop the icon turns into this ring, which fills and shows a check (cosmetic) -->
                        <motion:DropRing Stroke="{DynamicResource Cab.Accent}" StrokeThickness="3.5" motion:DropZone.Part="Ring" />
                    </Grid>
                    <TextBlock Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               FontSize="17"
                               FontWeight="{DynamicResource Cab.FontWeight.Strong}"
                               Foreground="{DynamicResource Cab.TextPrimary}"
                               Text="{loc:Loc Window_DropTitle}" />
                    <TextBlock Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource Cab.TextSecondary}"
                               Text="{loc:Loc Window_DropHint}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal dialogs (the title bar stays usable) -->
        <dialogs:DialogHost x:Name="Dialogs"
                            Grid.Row="1"
                            DataContext="{Binding Dialogs}"
                            LayoutTransform="{DynamicResource Cab.UiScaleTransform}"
                            Visibility="{Binding IsAnyOpen, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</ui:FluentWindow>
