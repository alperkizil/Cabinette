<!--
  Control styles for the thread view and its windows. Colors only via Cab.* DynamicResource keys.
  Hover/pressed states use a "tint" layer (Cab.TextPrimary at low opacity) so they work on any background in both themes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:local="clr-namespace:Cabinette.App.Views.Thread">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <local:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    <local:NullToVisibilityConverter x:Key="NullToVis" />
    <local:InverseBoolConverter x:Key="InverseBool" />
    <local:EnumEqualsConverter x:Key="EnumEquals" />
    <local:TypeSymbolConverter x:Key="TypeSymbol" />

    <!-- ============================================================ focus -->

    <Style x:Key="Cab.Thread.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderBrush="{DynamicResource Cab.Accent}" BorderThickness="2" CornerRadius="10" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ scrollbars (thin, overlay) -->

    <Style x:Key="Cab.Thread.ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Background="{DynamicResource Cab.TextSecondary}" CornerRadius="3" Opacity="0.4" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.65" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Cab.Thread.ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Cab.Thread.VerticalScrollBar" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" Margin="0,3" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Cab.Thread.ScrollPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Cab.Thread.ScrollPageButton}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb" Margin="4,0,3,0" Style="{StaticResource Cab.Thread.ScrollThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Thumb" Property="Margin" Value="2,0,2,0" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Cab.Thread.HorizontalScrollBar" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" Margin="3,0">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Cab.Thread.ScrollPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Cab.Thread.ScrollPageButton}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="Thumb" Margin="0,4,0,3" Style="{StaticResource Cab.Thread.ScrollThumb}" />
                </Track.Thumb>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Thumb" Property="Margin" Value="0,2,0,2" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Cab.Thread.ScrollBar" TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Width" Value="11" />
        <Setter Property="MinWidth" Value="11" />
        <Setter Property="Template" Value="{StaticResource Cab.Thread.VerticalScrollBar}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="11" />
                <Setter Property="MinHeight" Value="11" />
                <Setter Property="Template" Value="{StaticResource Cab.Thread.HorizontalScrollBar}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource Cab.Thread.ScrollBar}" />

    <Style x:Key="Cab.Thread.ScrollViewer" TargetType="ScrollViewer">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                CanHorizontallyScroll="False"
                                                CanVerticallyScroll="False"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   HorizontalAlignment="Right"
                                   Cursor="Arrow"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   Orientation="Vertical"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   VerticalAlignment="Bottom"
                                   Cursor="Arrow"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   Orientation="Horizontal"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollViewer" BasedOn="{StaticResource Cab.Thread.ScrollViewer}" />

    <!-- ============================================================ buttons -->

    <Style x:Key="Cab.Thread.IconButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cab.Thread.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Tint" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="19" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.14" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Cab.Thread.SmallIconButton" TargetType="Button" BasedOn="{StaticResource Cab.Thread.IconButton}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
    </Style>

    <Style x:Key="Cab.Thread.IconToggleButton" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cab.Thread.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Tint" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="19" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.14" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tint" Property="Background" Value="{DynamicResource Cab.Accent}" />
                            <Setter TargetName="Tint" Property="Opacity" Value="0.18" />
                            <Setter Property="Foreground" Value="{DynamicResource Cab.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Cab.Thread.AccentIconButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.OnAccent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cab.Thread.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Disc" Fill="{DynamicResource Cab.Accent}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource Cab.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round floating button with a soft shadow (scroll to bottom). -->
    <Style x:Key="Cab.Thread.FloatingButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse Fill="{DynamicResource Cab.HeaderBackground}" Stroke="{DynamicResource Cab.Divider}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="10" Direction="270" Opacity="0.2" ShadowDepth="2" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="Tint" Fill="{DynamicResource Cab.TextPrimary}" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.06" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded "pill" button with icon + label (bulk action bar, empty state). -->
    <Style x:Key="Cab.Thread.PillButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cab.Thread.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Tint" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="18" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.14" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Cab.Thread.DangerPillButton" TargetType="Button" BasedOn="{StaticResource Cab.Thread.PillButton}">
        <Setter Property="Foreground" Value="{DynamicResource Cab.Danger}" />
    </Style>

    <!-- Inline text link ("Read more", "Locate…"). -->
    <Style x:Key="Cab.Thread.LinkButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.Accent}" />
        <Setter Property="FontWeight" Value="{DynamicResource Cab.FontWeight.Strong}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Text" Background="Transparent" Text="{TemplateBinding Content}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dialog buttons. -->
    <Style x:Key="Cab.Thread.PrimaryButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.OnAccent}" />
        <Setter Property="FontWeight" Value="{DynamicResource Cab.FontWeight.Strong}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="MinWidth" Value="92" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cab.Thread.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Padding="{TemplateBinding Padding}" Background="{DynamicResource Cab.Accent}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Cab.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Cab.Thread.SecondaryButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="MinWidth" Value="92" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cab.Thread.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border BorderBrush="{DynamicResource Cab.Divider}" BorderThickness="1" CornerRadius="8" />
                        <Border x:Name="Tint" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="8" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.07" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.12" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- View switch segment (Chat / Grid / Details). -->
    <Style x:Key="Cab.Thread.SegmentRadio" TargetType="RadioButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cab.Thread.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Raised" Background="{DynamicResource Cab.InputBackground}" CornerRadius="6" Visibility="Collapsed" />
                        <Border x:Name="Tint" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="6" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.07" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Raised" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Tint" Property="Opacity" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource Cab.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter chips (ToggleButton or RadioButton). -->
    <Style x:Key="Cab.Thread.Chip" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cab.Thread.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Outline" BorderBrush="{DynamicResource Cab.Divider}" BorderThickness="1" CornerRadius="14" />
                        <Border x:Name="Fill" Background="{DynamicResource Cab.Accent}" CornerRadius="14" Visibility="Collapsed" />
                        <Border x:Name="Tint" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="14" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.07" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Outline" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource Cab.OnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Subcategory chip under the header. -->
    <Style x:Key="Cab.Thread.SubcategoryChip" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="4,4,12,4" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cab.Thread.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{DynamicResource Cab.InputBackground}" BorderBrush="{DynamicResource Cab.Divider}" BorderThickness="1" CornerRadius="16" />
                        <Border x:Name="Tint" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="16" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.12" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small outlined chip button (tag suggestions). -->
    <Style x:Key="Cab.Thread.SuggestionChip" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cab.Thread.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border BorderBrush="{DynamicResource Cab.Divider}" BorderThickness="1" CornerRadius="13" />
                        <Border x:Name="Tint" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="13" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.07" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.13" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ text boxes -->

    <!-- No chrome: placed inside a themed container. Placeholder text comes from Tag. -->
    <Style x:Key="Cab.Thread.BareTextBox" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Cab.Accent}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="{TemplateBinding Background}">
                        <TextBlock x:Name="Placeholder"
                                   Margin="2,0,0,0"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   Foreground="{DynamicResource Cab.TextSecondary}"
                                   IsHitTestVisible="False"
                                   Text="{TemplateBinding Tag}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Cab.Thread.ComposerTextBox" TargetType="TextBox" BasedOn="{StaticResource Cab.Thread.BareTextBox}">
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxHeight" Value="150" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <!-- Bordered input (filter extension box, tag editor). -->
    <Style x:Key="Cab.Thread.InputBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Cab.InputBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cab.Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,0" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Cab.Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ check boxes -->

    <!-- Round selection check on bubbles and tiles. -->
    <Style x:Key="Cab.Thread.SelectCheck" TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="22" Height="22">
                        <Ellipse x:Name="Ring" Fill="{DynamicResource Cab.InputBackground}" Stroke="{DynamicResource Cab.TextSecondary}" StrokeThickness="1.6" />
                        <Ellipse x:Name="Disc" Fill="{DynamicResource Cab.Accent}" Visibility="Collapsed" />
                        <ui:SymbolIcon x:Name="Check"
                                       FontSize="15"
                                       Filled="True"
                                       Foreground="{DynamicResource Cab.OnAccent}"
                                       Symbol="Checkmark20"
                                       Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Disc" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch with a label. -->
    <Style x:Key="Cab.Thread.Switch" TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cab.Thread.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent" LastChildFill="True">
                        <Grid Width="38" Height="20" DockPanel.Dock="Right">
                            <Border x:Name="Track" BorderBrush="{DynamicResource Cab.TextSecondary}" BorderThickness="1.5" CornerRadius="10" />
                            <Ellipse x:Name="Knob"
                                     Width="12"
                                     Height="12"
                                     Margin="4,0,0,0"
                                     HorizontalAlignment="Left"
                                     Fill="{DynamicResource Cab.TextSecondary}" />
                        </Grid>
                        <ContentPresenter Margin="0,0,12,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Cab.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Cab.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Cab.OnAccent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ sliders -->

    <Style x:Key="Cab.Thread.SliderFill" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Cab.Thread.SliderThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="14" Height="14" Background="Transparent">
                        <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{TemplateBinding Background}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="14" />
                            <Setter TargetName="Knob" Property="Height" Value="14" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Voice-note / media progress slider. Foreground = played part and knob. -->
    <Style x:Key="Cab.Thread.Slider" TargetType="Slider">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.Accent}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="18" Background="Transparent">
                        <Border Height="4" VerticalAlignment="Center" Background="{DynamicResource Cab.BubbleMetaText}" CornerRadius="2" Opacity="0.35" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Background="{TemplateBinding Foreground}" Command="Slider.DecreaseLarge" Style="{StaticResource Cab.Thread.SliderFill}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Background="Transparent" Command="Slider.IncreaseLarge" Style="{StaticResource Cab.Thread.SliderFill}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Background="{TemplateBinding Foreground}" Style="{StaticResource Cab.Thread.SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ chips & badges -->

    <!-- The extra tint keeps chips visible on bubbles whose color is close to the chip color (wheat). -->
    <DataTemplate x:Key="Cab.Thread.TagChipTemplate">
        <Grid Margin="0,4,4,0">
            <Border Background="{DynamicResource Cab.TagChipBackground}" CornerRadius="9" />
            <Border Background="{DynamicResource Cab.TagChipText}" CornerRadius="9" Opacity="0.1" />
            <TextBlock Margin="7,1,7,2" FontSize="11.5" Foreground="{DynamicResource Cab.TagChipText}" Text="{Binding StringFormat='#{0}'}" />
        </Grid>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="Cab.Thread.WrapPanel">
        <WrapPanel />
    </ItemsPanelTemplate>

    <!-- Date pill (inline date headers and the floating sticky date). -->
    <Style x:Key="Cab.Thread.DatePill" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Cab.DateHeaderBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cab.Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Padding" Value="12,4,12,5" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Cab.DateHeaderText}" />
        <Setter Property="TextElement.FontSize" Value="12.5" />
        <Setter Property="TextElement.FontWeight" Value="{DynamicResource Cab.FontWeight.Medium}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="5" Direction="270" Opacity="0.1" ShadowDepth="1" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Cab.Thread.MissingBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Cab.MissingBadgeBackground}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="6,1,7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Cab.MissingBadgeText}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="{DynamicResource Cab.FontWeight.Strong}" />
    </Style>

    <!-- Floating card (popups, dialogs). -->
    <Style x:Key="Cab.Thread.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Cab.SidebarBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cab.Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.22" ShadowDepth="6" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Cab.Thread.SectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="{DynamicResource Cab.FontWeight.Strong}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

</ResourceDictionary>
