<Window x:Class="Cabinette.App.Views.Thread.MediaViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Cabinette.App.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{loc:Loc Thread_ViewerTitle}"
        Width="1100"
        Height="760"
        MinWidth="520"
        MinHeight="360"
        Background="{DynamicResource Cab.WindowBackground}"
        FontFamily="{DynamicResource Shell.Font}"
        FontWeight="{DynamicResource Cab.FontWeight.Body}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <!-- Built-in viewer for images and videos (play/pause, seek, volume, open in the default player). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Cabinette;component/Views/Thread/ThreadResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="46" />
                <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="Disc" Fill="{DynamicResource Cab.HeaderBackground}" Opacity="0.85" Stroke="{DynamicResource Cab.Divider}" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Disc" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Cab.Divider}" BorderThickness="1" LayoutTransform="{DynamicResource Cab.UiScaleTransform}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Background="{DynamicResource Cab.HeaderBackground}" BorderBrush="{DynamicResource Cab.Divider}" BorderThickness="0,0,0,1">
                <DockPanel Margin="16,0,8,0">
                    <StackPanel VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="OpenExternal_Click" Style="{StaticResource Cab.Thread.PillButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,7,0" FontSize="17" Symbol="Open24" />
                                <TextBlock x:Name="OpenExternalText" Text="{loc:Loc Thread_ViewerOpenInApp}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="4,0,0,0" Click="Close_Click" Style="{StaticResource Cab.Thread.IconButton}" ToolTip="{loc:Loc Thread_ViewerClose}">
                            <ui:SymbolIcon FontSize="20" Symbol="Dismiss24" />
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock x:Name="TitleText" MaxWidth="560" FontSize="14" FontWeight="{DynamicResource Cab.FontWeight.Strong}" Foreground="{DynamicResource Cab.TextPrimary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="CounterText" Margin="10,0,0,0" FontSize="12.5" Foreground="{DynamicResource Cab.TextSecondary}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Stage -->
            <Grid x:Name="Stage" Grid.Row="1" Background="{DynamicResource Cab.ChatBackground}" MouseLeftButtonUp="Stage_MouseLeftButtonUp">
                <Image x:Name="ImageView" Margin="24" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" />
                <MediaElement x:Name="VideoView"
                              LoadedBehavior="Manual"
                              MediaEnded="VideoView_MediaEnded"
                              MediaFailed="VideoView_MediaFailed"
                              MediaOpened="VideoView_MediaOpened"
                              ScrubbingEnabled="True"
                              Stretch="Uniform"
                              UnloadedBehavior="Close"
                              Visibility="Collapsed" />
                <StackPanel x:Name="MessagePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <ui:SymbolIcon HorizontalAlignment="Center" FontSize="40" Foreground="{DynamicResource Cab.TextSecondary}" Symbol="DocumentDismiss24" />
                    <TextBlock x:Name="MessageText" Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource Cab.TextSecondary}" />
                </StackPanel>
                <Button x:Name="PrevButton" Margin="18,0,0,0" HorizontalAlignment="Left" Click="Prev_Click" Style="{StaticResource NavButton}" ToolTip="{loc:Loc Thread_ViewerPrevious}">
                    <ui:SymbolIcon FontSize="20" Symbol="ChevronLeft24" />
                </Button>
                <Button x:Name="NextButton" Margin="0,0,18,0" HorizontalAlignment="Right" Click="Next_Click" Style="{StaticResource NavButton}" ToolTip="{loc:Loc Thread_ViewerNext}">
                    <ui:SymbolIcon FontSize="20" Symbol="ChevronRight24" />
                </Button>
            </Grid>

            <!-- Video controls -->
            <Border x:Name="VideoBar"
                    Grid.Row="2"
                    Padding="12,8,16,8"
                    Background="{DynamicResource Cab.HeaderBackground}"
                    BorderBrush="{DynamicResource Cab.Divider}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayButton" Click="PlayPause_Click" Style="{StaticResource Cab.Thread.AccentIconButton}" ToolTip="{loc:Loc Thread_ViewerPlayPause}">
                        <Grid>
                            <ui:SymbolIcon x:Name="PlayIcon" Margin="2,0,0,0" FontSize="20" Filled="True" Symbol="Play24" />
                            <ui:SymbolIcon x:Name="PauseIcon" FontSize="20" Filled="True" Symbol="Pause24" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <TextBlock x:Name="PositionText"
                               Grid.Column="1"
                               MinWidth="44"
                               Margin="14,0,10,0"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               Foreground="{DynamicResource Cab.TextSecondary}"
                               Text="0:00"
                               TextAlignment="Right" />
                    <Slider x:Name="PositionSlider" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Cab.Thread.Slider}" ValueChanged="PositionSlider_ValueChanged" />
                    <TextBlock x:Name="DurationText"
                               Grid.Column="3"
                               MinWidth="44"
                               Margin="10,0,18,0"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               Foreground="{DynamicResource Cab.TextSecondary}"
                               Text="0:00" />
                    <Button Grid.Column="4" Click="Mute_Click" Style="{StaticResource Cab.Thread.IconButton}" ToolTip="{loc:Loc Thread_ViewerMute}">
                        <Grid>
                            <ui:SymbolIcon x:Name="VolumeIcon" FontSize="20" Symbol="Speaker224" />
                            <ui:SymbolIcon x:Name="MutedIcon" FontSize="20" Symbol="SpeakerMute24" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Slider x:Name="VolumeSlider"
                            Grid.Column="5"
                            Width="96"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Maximum="1"
                            Style="{StaticResource Cab.Thread.Slider}"
                            Value="{Binding Volume, ElementName=VideoView, Mode=TwoWay}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
