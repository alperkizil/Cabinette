<!--
  Light theme: "Classic wheat" (SPEC.md section 11).
  Every Cabinette surface uses these keys through {DynamicResource ...} so the theme can be swapped at runtime.
  Dark.xaml must define exactly the same keys.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Cab.AccentColor">#C8963E</Color>

    <SolidColorBrush x:Key="Cab.WindowBackground" Color="#FBF3E4" />
    <SolidColorBrush x:Key="Cab.SidebarBackground" Color="#FFFDF8" />
    <SolidColorBrush x:Key="Cab.HeaderBackground" Color="#F5EBD6" />
    <SolidColorBrush x:Key="Cab.ChatBackground" Color="#FBF3E4" />
    <SolidColorBrush x:Key="Cab.InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Cab.SearchBoxBackground" Color="#F5EBD6" />

    <SolidColorBrush x:Key="Cab.BubbleCopyBackground" Color="#F2DDB0" />
    <SolidColorBrush x:Key="Cab.BubblePointerBackground" Color="#DCE9F5" />
    <SolidColorBrush x:Key="Cab.BubblePointerBorder" Color="#BCD3EA" />
    <!-- Grid note tiles are wheat "paper", a shade warmer than the copy bubbles (SPEC.md section 4). -->
    <SolidColorBrush x:Key="Cab.NoteTileBackground" Color="#F5DEB3" />
    <SolidColorBrush x:Key="Cab.BubbleMetaText" Color="#7F6C4B" />

    <SolidColorBrush x:Key="Cab.Accent" Color="#C8963E" />
    <SolidColorBrush x:Key="Cab.AccentHover" Color="#B9873A" />
    <SolidColorBrush x:Key="Cab.OnAccent" Color="#3D2B0F" />

    <SolidColorBrush x:Key="Cab.TextPrimary" Color="#3D3222" />
    <SolidColorBrush x:Key="Cab.TextSecondary" Color="#7F6C4B" />
    <SolidColorBrush x:Key="Cab.Divider" Color="#E6D6B8" />

    <SolidColorBrush x:Key="Cab.RowHover" Color="#F8EDD8" />
    <SolidColorBrush x:Key="Cab.RowSelected" Color="#F3E3C3" />
    <!-- Outline of the selected row and keyboard focus ring: the gold accent, a shade deeper here so it keeps 3:1 against
         the near-white sidebar. -->
    <SolidColorBrush x:Key="Cab.SelectionBorder" Color="#A87A2A" />

    <SolidColorBrush x:Key="Cab.DateHeaderBackground" Color="#FFFDF8" />
    <SolidColorBrush x:Key="Cab.DateHeaderText" Color="#6B5A3A" />

    <SolidColorBrush x:Key="Cab.TagChipBackground" Color="#EFDDB5" />
    <SolidColorBrush x:Key="Cab.TagChipText" Color="#5C4317" />

    <SolidColorBrush x:Key="Cab.Danger" Color="#C0392B" />
    <SolidColorBrush x:Key="Cab.MissingBadgeBackground" Color="#F6D5CF" />
    <SolidColorBrush x:Key="Cab.MissingBadgeText" Color="#8E2A1E" />

    <SolidColorBrush x:Key="Cab.OverlayBackground" Color="#663D3222" />

    <!-- Thread banner (SPEC.md section 4): the band takes the category's avatar color; these cover the rest. -->
    <SolidColorBrush x:Key="Cab.BannerFallbackBackground" Color="#8A6A3A" />
    <SolidColorBrush x:Key="Cab.BannerText" Color="#FFFFFF" />

    <!-- Gallery (SPEC.md section 4): the print frame around each photo or video shows its mode, amber for copies and blue for
         pointers (a little stronger than the chat bubbles' shades, so a thin frame doesn't read as white). -->
    <SolidColorBrush x:Key="Cab.GalleryFrameCopy" Color="#D2AE66" />
    <SolidColorBrush x:Key="Cab.GalleryFramePointer" Color="#98BCE3" />

</ResourceDictionary>
