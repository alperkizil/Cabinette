<!--
  Shared control styles for Cabinette (merged at index 3 in App.xaml, after the theme tokens).
  Implicit styles: ScrollViewer, ScrollBar, ToolTip, ContextMenu, MenuItem (+ separator), CategoryAvatar.
  Everything else is keyed ("Shell.*") so views opt in. Colors come only from the Cab.* tokens via DynamicResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:conv="clr-namespace:Cabinette.App.Converters"
                    xmlns:shell="clr-namespace:Cabinette.App.Views.Shell">

    <!-- ============================================================ typography -->
    <!-- The families (Shell.Font for text, Shell.FontDisplay for titles) are app-level resources, replaced live by Services/UiFont. -->

    <Style x:Key="Shell.Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Shell.FontDisplay}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="{DynamicResource Cab.FontWeight.Strong}" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
    </Style>

    <Style x:Key="Shell.Text.DialogTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Shell.FontDisplay}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="{DynamicResource Cab.FontWeight.Strong}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
    </Style>

    <Style x:Key="Shell.Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="{DynamicResource Cab.FontWeight.Strong}" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
    </Style>

    <Style x:Key="Shell.Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
    </Style>

    <Style x:Key="Shell.Text.Secondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextSecondary}" />
    </Style>

    <Style x:Key="Shell.Text.Section" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="{DynamicResource Cab.FontWeight.Strong}" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.Accent}" />
    </Style>

    <Style x:Key="Shell.Text.Error" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.Danger}" />
    </Style>

    <!-- ============================================================ converters -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:IconKeyToSymbolConverter x:Key="IconKeyToSymbol" />
    <conv:EnumEqualsConverter x:Key="EnumEquals" />
    <conv:BoolEqualsConverter x:Key="BoolEquals" />
    <conv:MultiplyConverter x:Key="Multiply" />
    <conv:NotificationSymbolConverter x:Key="NotificationSymbol" />
    <conv:AddConverter x:Key="Add" />
    <conv:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
    <conv:CircleClipConverter x:Key="CircleClip" />

    <!-- ============================================================ focus visual -->
    <Style x:Key="Shell.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderBrush="{DynamicResource Cab.SelectionBorder}" BorderThickness="2" CornerRadius="10" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Shell.FocusVisualRound">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-1" BorderBrush="{DynamicResource Cab.TextPrimary}" BorderThickness="2" CornerRadius="20" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ scrolling -->
    <Style x:Key="Shell.ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" CornerRadius="4" Background="{DynamicResource Cab.TextSecondary}" Opacity="0.45" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Shell.ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Shell.ScrollPageButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Shell.ScrollPageButton}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Margin="4,3" Style="{StaticResource Shell.ScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Margin" Value="2,3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Shell.ScrollPageButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Shell.ScrollPageButton}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb" Margin="3,4" Style="{StaticResource Shell.ScrollThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Thumb" Property="Margin" Value="3,2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Overlay scroll bars that fade in while the pointer is over the scroll viewer. -->
    <Style TargetType="ScrollViewer">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   HorizontalAlignment="Right"
                                   Cursor="Arrow"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   Minimum="0"
                                   Opacity="0"
                                   Orientation="Vertical"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Value="{TemplateBinding VerticalOffset}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   VerticalAlignment="Bottom"
                                   Cursor="Arrow"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   Minimum="0"
                                   Opacity="0"
                                   Orientation="Horizontal"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Value="{TemplateBinding HorizontalOffset}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="PART_HorizontalScrollBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar" Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:0.6" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="PART_HorizontalScrollBar" Storyboard.TargetProperty="Opacity" To="0" BeginTime="0:0:0.6" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ tooltips & menus -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="LayoutTransform" Value="{DynamicResource Cab.UiScaleTransform}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Shell.Font}" />
        <Setter Property="FontSize" Value="12" />
        <!-- Tooltips and context menus are trees of their own: they take the text weight here, not from the window. -->
        <Setter Property="FontWeight" Value="{DynamicResource Cab.FontWeight.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Margin="6,6,6,10"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource Cab.InputBackground}"
                            BorderBrush="{DynamicResource Cab.Divider}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Opacity="0.18" ShadowDepth="2" Direction="270" />
                        </Border.Effect>
                        <ContentPresenter MaxWidth="320">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="LayoutTransform" Value="{DynamicResource Cab.UiScaleTransform}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Shell.Font}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="{DynamicResource Cab.FontWeight.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="10,6,10,14"
                            Padding="5"
                            MinWidth="220"
                            Background="{DynamicResource Cab.InputBackground}"
                            BorderBrush="{DynamicResource Cab.Divider}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" Opacity="0.22" ShadowDepth="4" Direction="270" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="Padding" Value="10,0,14,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Hover" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="6" Opacity="0" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Gesture" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="IconHost"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              ContentSource="Icon"
                                              TextElement.FontSize="18" />
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                            <TextBlock Grid.Column="2"
                                       Margin="24,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource Cab.TextSecondary}"
                                       Text="{TemplateBinding InputGestureText}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.07" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.12" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,5" Background="{DynamicResource Cab.Divider}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ buttons -->
    <Style x:Key="Shell.ButtonBase" TargetType="ButtonBase">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Shell.AccentButton" TargetType="Button" BasedOn="{StaticResource Shell.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Cab.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.OnAccent}" />
        <Setter Property="FontWeight" Value="{DynamicResource Cab.FontWeight.Strong}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" />
                        <Border x:Name="Overlay" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="8" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Cab.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Shell.DangerButton" TargetType="Button" BasedOn="{StaticResource Shell.AccentButton}">
        <Setter Property="Background" Value="{DynamicResource Cab.Danger}" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.SidebarBackground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" />
                        <Border x:Name="Overlay" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="8" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.18" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Shell.SecondaryButton" TargetType="Button" BasedOn="{StaticResource Shell.ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cab.Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" />
                        <Border x:Name="Overlay" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="8" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.11" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Full-width option button used by the choice dialog. -->
    <Style x:Key="Shell.OptionButton" TargetType="Button" BasedOn="{StaticResource Shell.SecondaryButton}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="Shell.TextButton" TargetType="Button" BasedOn="{StaticResource Shell.ButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource Cab.Accent}" />
        <Setter Property="FontWeight" Value="{DynamicResource Cab.FontWeight.Strong}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Overlay" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="8" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.11" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round icon button (header actions, search clear, back arrow). Content: a ui:SymbolIcon. -->
    <Style x:Key="Shell.IconButton" TargetType="ButtonBase" BasedOn="{StaticResource Shell.ButtonBase}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextSecondary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisualRound}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <Border x:Name="Overlay" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="19" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.08" />
                            <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.14" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.1" />
                            <Setter Property="Foreground" Value="{DynamicResource Cab.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small square-ish icon button (e.g. inside text boxes). -->
    <Style x:Key="Shell.SmallIconButton" TargetType="Button" BasedOn="{StaticResource Shell.IconButton}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Pill toggle chip (filters). Works for ToggleButton, CheckBox and RadioButton. -->
    <Style x:Key="Shell.Chip" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cab.Divider}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="15" />
                        <Border x:Name="Overlay" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="15" Opacity="0" />
                        <StackPanel Margin="{TemplateBinding Padding}" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon x:Name="Check" Margin="-2,0,4,0" FontSize="14" Symbol="Checkmark16" Visibility="Collapsed" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.05" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cab.TagChipBackground}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Cab.TagChipBackground}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Cab.TagChipText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Radio option with a round indicator (settings). Content can be any element. -->
    <Style x:Key="Shell.RadioOption" TargetType="RadioButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Overlay" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="8" Opacity="0" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="20" Height="20" VerticalAlignment="Top" Margin="0,0,0,0">
                                <Ellipse x:Name="Ring" Stroke="{DynamicResource Cab.TextSecondary}" StrokeThickness="1.5" />
                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource Cab.Accent}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.04" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Cab.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Cab.Accent}" />
                            <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch (CheckBox). Content is the label on the left. -->
    <Style x:Key="Shell.ToggleSwitch" TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="Overlay" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="8" Opacity="0" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Margin="0,0,16,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <Grid Grid.Column="1" Width="40" Height="20" VerticalAlignment="Center">
                                <Border x:Name="Track" BorderBrush="{DynamicResource Cab.TextSecondary}" BorderThickness="1.5" CornerRadius="10" Background="Transparent" />
                                <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left" Fill="{DynamicResource Cab.TextSecondary}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="KnobShift" X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.04" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Cab.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Cab.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Cab.SidebarBackground}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ text boxes -->
    <!-- Bordered rounded text box. Placeholder text goes in Tag. -->
    <Style x:Key="Shell.TextBox" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Cab.InputBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cab.Divider}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Cab.Accent}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock x:Name="Placeholder"
                                       Margin="{TemplateBinding Padding}"
                                       Padding="2,0,0,0"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       Foreground="{DynamicResource Cab.TextSecondary}"
                                       IsHitTestVisible="False"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Cab.TextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Cab.Accent}" />
                            <Setter TargetName="Border" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless text box for composite inputs (search pill). Placeholder text goes in Tag. -->
    <Style x:Key="Shell.BareTextBox" TargetType="TextBox" BasedOn="{StaticResource Shell.TextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="Transparent">
                        <TextBlock x:Name="Placeholder"
                                   Margin="{TemplateBinding Padding}"
                                   Padding="2,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Cab.TextSecondary}"
                                   IsHitTestVisible="False"
                                   Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ drop-down list -->
    <!-- One choice in a Shell.ComboBox list: a menu-like row with a check on the current choice. -->
    <Style x:Key="Shell.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="8,0,14,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Background="Transparent">
                        <Border x:Name="Hover" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="6" Opacity="0" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="Check" FontSize="16" Foreground="{DynamicResource Cab.Accent}" Symbol="Checkmark16" Visibility="Hidden" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.07" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Drop-down list (Settings › Appearance › Font): a rounded box like Shell.TextBox with a chevron, and its list in a card
        like the context menus. The list is a popup, a window of its own, so it takes the text-size transform itself.
    -->
    <Style x:Key="Shell.ComboBox" TargetType="ComboBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Cab.InputBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cab.Divider}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,0,40,0" />
        <Setter Property="MaxDropDownHeight" Value="380" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Shell.ComboBoxItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- No style: WPF-UI's implicit ToggleButton style would otherwise size and place it. -->
                        <ToggleButton x:Name="Toggle"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      OverridesDefaultStyle="True"
                                      Style="{x:Null}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      ClickMode="Press"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" />
                                        <Border x:Name="Overlay" Background="{DynamicResource Cab.TextPrimary}" CornerRadius="8" Opacity="0" />
                                        <ui:SymbolIcon Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource Cab.TextSecondary}" Symbol="ChevronDown16" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Cab.TextSecondary}" />
                                            <Setter TargetName="Overlay" Property="Opacity" Value="0.03" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Cab.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=Toggle}"
                               PopupAnimation="None">
                            <Border Margin="0,4,10,14"
                                    Padding="5"
                                    MinWidth="{Binding ActualWidth, ElementName=Toggle}"
                                    Background="{DynamicResource Cab.InputBackground}"
                                    BorderBrush="{DynamicResource Cab.Divider}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    LayoutTransform="{DynamicResource Cab.UiScaleTransform}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.22" ShadowDepth="4" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" Focusable="False">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Cab.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ lists -->
    <Style x:Key="Shell.ListBox" TargetType="ListBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,0,0,8" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="ScrollViewer" Padding="{TemplateBinding Padding}" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded, inset row (chat list, search results, pickers). -->
    <Style x:Key="Shell.RowItem" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <!-- Arrow keys move the selection, and the selected row already has the green outline. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <!-- The selected row gets a gold outline (Cab.SelectionBorder, both themes); the 2px border is always reserved so nothing shifts.
                         "Bd" is also used by Views/Shell/ChatListMotion (an opaque background while a row glides over others). -->
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cab.RowHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cab.RowSelected}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Cab.SelectionBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section headers inside result lists: not selectable, no hover. -->
    <Style x:Key="Shell.HeaderItem" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings navigation entry. -->
    <Style x:Key="Shell.NavItem" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Shell.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.TextPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" />
                        <Border x:Name="Pill" Width="3" Height="16" Margin="1,0,0,0" HorizontalAlignment="Left" Background="{DynamicResource Cab.Accent}" CornerRadius="1.5" Visibility="Collapsed" />
                        <ContentPresenter Margin="12,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cab.RowHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cab.RowSelected}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ misc -->
    <Style x:Key="Shell.ProgressBar" TargetType="ProgressBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="4" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Cab.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Cab.Divider}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" />
                        <Border x:Name="Runner" Width="90" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="RunnerShift" X="-90" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Runner" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Run">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="RunnerShift" Storyboard.TargetProperty="X" From="-90" To="420" Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Run" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card surface for dialogs, flyouts and the snackbar. -->
    <Style x:Key="Shell.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Cab.SidebarBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cab.Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="28" Direction="270" Opacity="0.22" ShadowDepth="6" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Category avatar: PNG icon, or a themed circle with a Fluent glyph. -->
    <Style TargetType="shell:CategoryAvatar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shell:CategoryAvatar">
                    <Grid Width="{TemplateBinding Size}" Height="{TemplateBinding Size}">
                        <Grid x:Name="Fallback" Visibility="Collapsed">
                            <Ellipse x:Name="FallbackCircle" Fill="{DynamicResource Cab.TagChipBackground}" />
                            <ui:SymbolIcon x:Name="FallbackGlyph"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="{Binding Size, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Multiply}, ConverterParameter=0.48}"
                                           Foreground="{DynamicResource Cab.TagChipText}"
                                           Symbol="{Binding IconKey, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconKeyToSymbol}}" />
                        </Grid>
                        <Image x:Name="Picture"
                               Clip="{Binding Size, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource CircleClip}}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{TemplateBinding Source}"
                               Stretch="UniformToFill" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Source" Value="{x:Null}">
                            <Setter TargetName="Fallback" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Picture" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- The chat list's "Starred" row: a filled star on the accent, like the thread header's avatar. -->
                        <Trigger Property="IconKey" Value="starred">
                            <Setter TargetName="FallbackCircle" Property="Fill" Value="{DynamicResource Cab.Accent}" />
                            <Setter TargetName="FallbackGlyph" Property="Foreground" Value="{DynamicResource Cab.OnAccent}" />
                            <Setter TargetName="FallbackGlyph" Property="Filled" Value="True" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
