<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>Cabinette</AssemblyName>
    <RootNamespace>Cabinette.App</RootNamespace>
    <!-- Program.Main, not the Main WPF generates from App.xaml: the text-extraction child is decided before WPF starts. -->
    <StartupObject>Cabinette.App.Program</StartupObject>
    <!-- Generated by tools/Cabinette.IconGen from assets/logo. -->
    <ApplicationIcon>..\..\assets\icons\Cabinette.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- App and tray icons plus the vector logo (all generated by tools/Cabinette.IconGen into assets/icons). -->
  <ItemGroup>
    <Resource Include="..\..\assets\icons\Cabinette.ico" Link="Assets\Cabinette.ico" />
    <Resource Include="..\..\assets\icons\tray-idle.ico" Link="Assets\tray-idle.ico" />
    <Resource Include="..\..\assets\icons\tray-syncing.ico" Link="Assets\tray-syncing.ico" />
    <Resource Include="..\..\assets\icons\tray-paused.ico" Link="Assets\tray-paused.ico" />
    <Resource Include="..\..\assets\icons\tray-error.ico" Link="Assets\tray-error.ico" />
    <Page Include="..\..\assets\icons\CabinetteLogo.xaml" Link="Assets\CabinetteLogo.xaml" Generator="MSBuild:Compile" />
  </ItemGroup>

  <!--
    The bundled fonts of Settings › Appearance › Font (assets/fonts, SIL OFL 1.1): embedded, so no loose font files ship,
    and each license next to Cabinette.exe as the OFL requires (licenses\<folder>-OFL.txt).
  -->
  <ItemGroup>
    <Resource Include="..\..\assets\fonts\**\*.ttf" Link="Assets\Fonts\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\assets\fonts\Inter\LICENSE.txt" Link="licenses\Inter-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\assets\fonts\SourceSans3\LICENSE.md" Link="licenses\SourceSans3-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\assets\fonts\AtkinsonHyperlegibleNext\OFL.txt" Link="licenses\AtkinsonHyperlegibleNext-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\assets\fonts\Lexend\OFL.txt" Link="licenses\Lexend-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\assets\fonts\JetBrainsMono\OFL.txt" Link="licenses\JetBrainsMono-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cabinette.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cabinette.Core\Cabinette.Core.csproj" />
    <ProjectReference Include="..\Cabinette.Ipc\Cabinette.Ipc.csproj" />
    <ProjectReference Include="..\Cabinette.Windows\Cabinette.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
